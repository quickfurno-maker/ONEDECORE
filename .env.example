# ONEDECORE environment template.
#
# Every supported key is listed. Secrets are blank; activation gates default to
# OFF. Copy to .env.local (gitignored) and fill in what the machine needs.
#
# The canonical list lives in src/config/env-contract.ts and this file is
# checked against it, and against what the source actually reads, by
# `npm run verify:env` in CI. A key added to the code without appearing here
# fails the build — which is how twenty-one supported variables came to be
# undocumented before the guard existed.
#
# Rules that the guard enforces:
#   - NEXT_PUBLIC_ values are compiled into browser JavaScript. Never a secret.
#   - An unset activation gate means the feature is OFF, not misconfigured.
#   - No real credential belongs in this file.


# =============================================================================
# CORE / SUPABASE
# =============================================================================

# The Supabase project every client targets. In production this must be the
# managed ONEDECORE project; outside production a loopback stack is accepted.
# Anything else is refused — see src/lib/supabase/runtime-target.ts.
NEXT_PUBLIC_SUPABASE_URL=
# Server-side alias, accepted where a host sets it. Same validation.
SUPABASE_URL=
# Browser key. RLS applies to everything it can reach.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses RLS entirely. Server-only, never NEXT_PUBLIC_. Rejected if it looks
# like a publishable key or repeats the publishable value.
SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# PUBLIC APP
# =============================================================================

# Absolute public origin, no trailing slash. Used to build links inside
# outbound messages.
NEXT_PUBLIC_APP_URL=
# The WhatsApp number shown to visitors when online enquiry is unavailable.
# Public by design: it is printed on the site.
NEXT_PUBLIC_ONEDECORE_WHATSAPP_E164=


# =============================================================================
# LEAD INTAKE
# =============================================================================

# THIS IS THE ONLY AUTHORITY ON WHETHER THE PUBLIC FORM SUBMITS.
#
# There used to be a second, browser-side flag
# (NEXT_PUBLIC_ONEDECORE_LEAD_FORM_MODE). It was removed: a NEXT_PUBLIC_ value
# is baked into the HTML at build time and cannot know the state of the running
# server, so the browser could show an active form while the server accepted
# nothing. A real enquiry was lost that way. The site now asks the server at
# runtime (GET /api/public/lead-intake/readiness) and shows no editable field
# unless the answer is yes.
#
# ONEDECORE_LEAD_INTAKE_MODE=disabled | local-test | enabled
#   disabled    the public form reports unavailable and offers direct contact
#   local-test  real submission against a LOOPBACK Supabase only; refused when
#               NODE_ENV=production
#   enabled     production. Additionally requires the managed OneDecore Supabase
#               URL, a real service-role key, ONEDECORE_LEAD_HASH_SECRET of at
#               least 32 characters, ONEDECORE_TRUST_PROXY=true behind a proxy
#               that overwrites client headers, and the legal/consent/processor
#               activation gates complete. Any one missing fails closed.
ONEDECORE_LEAD_INTAKE_MODE=disabled
# Fingerprints phone numbers and network identifiers for de-duplication.
# Minimum 32 characters. Belongs to lead intake alone — no other domain may
# borrow it, and none does.
ONEDECORE_LEAD_HASH_SECRET=
# Trust X-Forwarded-For. Only safe behind a reverse proxy that OVERWRITES the
# header; if the proxy appends instead, a caller can choose their own client IP.
ONEDECORE_TRUST_PROXY=false


# =============================================================================
# QUOTATION
# =============================================================================

# Signs the capability tokens that let a customer open and accept a quotation
# without an account. Minimum 32 bytes, server-only.
QUOTATION_CAPABILITY_SECRET=


# =============================================================================
# COMMERCE
# =============================================================================

# Public /shop + COD storefront. Fail-closed; currently OFF.
# Deploying the code does not activate it.
ONEDECORE_SHOP_PUBLIC_ENABLED=false
# Derives network/phone fingerprints, reviewed-quote tokens and tracking proof
# cookies for public commerce. Minimum 32 characters. Needed only once the shop
# is enabled.
ONEDECORE_COMMERCE_PUBLIC_RUNTIME_SECRET=


# =============================================================================
# LANDING LAB
# =============================================================================

# Serves /lp/<slug> publicly. Default OFF.
ONEDECORE_LANDING_LAB_PUBLIC_ENABLED=false
# Signs the publication context that decides which campaign a lead is
# attributed to. REQUIRED for landing attribution in production, with NO
# fallback: it used to borrow ONEDECORE_LEAD_HASH_SECRET, which meant rotating
# one secret could silently break the other domain. Missing now fails closed —
# the enquiry is still accepted, it simply carries no attribution the server
# cannot prove. Minimum 32 characters, and never the lead secret.
ONEDECORE_LANDING_LAB_HMAC_SECRET=


# =============================================================================
# WHATSAPP (Meta Cloud API)
# =============================================================================

# Inbound webhook. Fail-closed; currently disabled.
# ONEDECORE_WHATSAPP_WEBHOOK_MODE=disabled | local-test | enabled
ONEDECORE_WHATSAPP_WEBHOOK_MODE=disabled
# Outbound dispatch. Fail-closed; currently disabled.
# ONEDECORE_WHATSAPP_OUTBOUND_MODE=disabled | local-test | enabled
ONEDECORE_WHATSAPP_OUTBOUND_MODE=disabled
# Verifies X-Hub-Signature-256 on inbound webhooks.
META_WHATSAPP_APP_SECRET=
# Answers Meta's webhook verification handshake.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Graph API credential for outbound sends.
META_WHATSAPP_ACCESS_TOKEN=
# The business phone number id messages are sent from.
META_WHATSAPP_PHONE_NUMBER_ID=
# Pins the Graph API version. A reviewed default applies when unset.
META_WHATSAPP_GRAPH_API_VERSION=


# =============================================================================
# CAMPAIGN EXECUTION
# =============================================================================
#
# Two gates guard live provider traffic, and BOTH being set is still not enough:
# the live transport is deliberately unimplemented, so no configuration here
# reaches Meta or Google today. Live activation is its own certified piece of
# work, not an environment change.

# ONEDECORE_CAMPAIGN_EXECUTION_MODE=disabled | mock | sandbox | live
ONEDECORE_CAMPAIGN_EXECUTION_MODE=disabled
# First gate. Default OFF.
ONEDECORE_CAMPAIGN_PRODUCTION_ENABLED=false
# Second gate, for sandbox transport specifically. Default OFF.
ONEDECORE_CAMPAIGN_SANDBOX_TRANSPORT_ENABLED=false
# Signs run/target execution context. Minimum 32 characters. Its own secret —
# do not reuse ONEDECORE_LANDING_LAB_HMAC_SECRET.
ONEDECORE_CAMPAIGN_EXECUTION_HMAC_SECRET=
# Authenticates POST /api/internal/campaign-execution/dispatch. Minimum 32
# characters, never NEXT_PUBLIC_.
ONEDECORE_CAMPAIGN_EXECUTION_WORKER_SECRET=
# Permits sharing CRM identifiers with ad providers. Default OFF — a privacy
# decision, not a performance one.
ONEDECORE_PROVIDER_DATA_SHARING_ENABLED=false


# =============================================================================
# META ADS
# =============================================================================
# Unused while live provider transport stays closed. Present so an environment
# can be prepared and reviewed before any activation decision.

ONEDECORE_META_ADS_ACCOUNT_ID=
ONEDECORE_META_ADS_ACCESS_TOKEN=
# Pins the Marketing API version; a default applies when unset.
ONEDECORE_META_ADS_GRAPH_VERSION=
ONEDECORE_META_ADS_PAGE_ID=
# Conversions dataset. Falls back to the pixel id below when unset.
ONEDECORE_META_ADS_DATASET_ID=
ONEDECORE_META_ADS_PIXEL_ID=


# =============================================================================
# GOOGLE ADS
# =============================================================================
# Same posture as Meta Ads: configurable, not yet reachable.

ONEDECORE_GOOGLE_ADS_CUSTOMER_ID=
# Manager account used to authenticate against the customer.
ONEDECORE_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
ONEDECORE_GOOGLE_ADS_DEVELOPER_TOKEN=
ONEDECORE_GOOGLE_ADS_CLIENT_ID=
ONEDECORE_GOOGLE_ADS_CLIENT_SECRET=
ONEDECORE_GOOGLE_ADS_REFRESH_TOKEN=
# Conversion action resource name used for uploads.
ONEDECORE_GOOGLE_ADS_CONVERSION_ACTION=


# =============================================================================
# KRITI (assistant)
# =============================================================================

# Provider mode. Fail-closed; currently disabled.
ONEDECORE_KRITI_MODE=disabled
# Groq credential. Required only once Kriti is enabled.
ONEDECORE_KRITI_GROQ_API_KEY=
# Overrides the default model identifier.
ONEDECORE_KRITI_GROQ_MODEL=
# Per-request provider timeout in milliseconds.
ONEDECORE_KRITI_TIMEOUT_MS=


# =============================================================================
# LOCAL / TEST ONLY
# =============================================================================
# Commented deliberately. These must never be set in production, and the
# contract guard fails the build if they appear as active lines.

# Lets local fixtures sign a Landing Lab publication context. Ignored entirely
# when NODE_ENV=production.
# ONEDECORE_LANDING_LAB_HMAC_TEST_SECRET=

# Forces a dispatcher outcome in local tests:
# success | transient_failure | validation_failure | timeout_unknown |
# reconcile_found | reconcile_not_found
# ONEDECORE_CAMPAIGN_EXECUTION_MOCK_SCENARIO=

# NODE_ENV is set by the runtime, not by an operator. Production tightens the
# Supabase target rule and forbids local-test lead intake.
# NODE_ENV=development
