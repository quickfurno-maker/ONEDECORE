# Public Supabase configuration — safe for browser use only with correct RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phase 4B2 public lead form UI (browser-safe). Default remains copy-only.
# NEXT_PUBLIC_ONEDECORE_LEAD_FORM_MODE=copy-only | preview | active
NEXT_PUBLIC_ONEDECORE_LEAD_FORM_MODE=copy-only

# Phase 4A lead intake (server-only). Default remains disabled.
# ONEDECORE_LEAD_INTAKE_MODE=disabled | local-test | enabled
ONEDECORE_LEAD_INTAKE_MODE=
# Phase 6A Meta WhatsApp webhook (server-only). Default remains disabled.
# ONEDECORE_WHATSAPP_WEBHOOK_MODE=disabled | local-test | enabled
ONEDECORE_WHATSAPP_WEBHOOK_MODE=
# Phase 6B-B4 WhatsApp outbound dispatch (server-only). Default remains disabled.
# ONEDECORE_WHATSAPP_OUTBOUND_MODE=disabled | local-test | enabled
ONEDECORE_WHATSAPP_OUTBOUND_MODE=
# Meta Graph API version for outbound dispatch (server-only). Official docs reviewed for v21/v22/v25.
# META_WHATSAPP_GRAPH_API_VERSION=v22.0
# Meta Cloud API access token for outbound dispatch (server-only; never NEXT_PUBLIC_)
META_WHATSAPP_ACCESS_TOKEN=
# Default business phone number id for enabled-mode env validation (server-only)
META_WHATSAPP_PHONE_NUMBER_ID=
# Meta webhook verification token (server-only; never NEXT_PUBLIC_)
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret for X-Hub-Signature-256 verification (server-only)
META_WHATSAPP_APP_SECRET=
# HMAC secret for quotation capability tokens (server-only; min 32 bytes; never NEXT_PUBLIC_)
QUOTATION_CAPABILITY_SECRET=
# Public origin used to construct ephemeral /q/[token] links at dispatch time (no trailing slash)
NEXT_PUBLIC_APP_URL=

# Service-role key for admin client / submit_lead_intake RPC — never NEXT_PUBLIC_
# Canonical elevated key name (do not use SUPABASE_SECRET_KEY).
SUPABASE_SERVICE_ROLE_KEY=
# HMAC secret for request/network/phone fingerprints (min 32 chars)
ONEDECORE_LEAD_HASH_SECRET=
# Phase 9D-D2 commerce public runtime (server-only; min 32 chars; never NEXT_PUBLIC_)
# Derives network/phone fingerprints, reviewed-quote tokens, and tracking proof cookies.
ONEDECORE_COMMERCE_PUBLIC_RUNTIME_SECRET=
# Trust X-Forwarded-For only behind a reverse proxy that overwrites the header
ONEDECORE_TRUST_PROXY=false

# Phase 9C-B campaign execution (server-only). Default remains disabled. sandbox/live fail closed until 9C-C adapters exist.
# ONEDECORE_CAMPAIGN_EXECUTION_MODE=disabled | mock | sandbox | live
ONEDECORE_CAMPAIGN_EXECUTION_MODE=disabled
# Dedicated HMAC secret for signed run/target execution context (min 32 chars). Do not reuse ONEDECORE_LANDING_LAB_HMAC_SECRET.
ONEDECORE_CAMPAIGN_EXECUTION_HMAC_SECRET=
# Internal worker POST /api/internal/campaign-execution/dispatch (min 32 chars; never NEXT_PUBLIC_)
ONEDECORE_CAMPAIGN_EXECUTION_WORKER_SECRET=
# Provider CRM-identifier sharing production gate. Default OFF. 9C-B still makes no real Ads calls.
ONEDECORE_PROVIDER_DATA_SHARING_ENABLED=false
# Optional mock scenario for local dispatcher tests: success | transient_failure | validation_failure | timeout_unknown | reconcile_found | reconcile_not_found
# ONEDECORE_CAMPAIGN_EXECUTION_MOCK_SCENARIO=success
