{
  "name": "onedecore",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level warning",
    "db:test": "supabase test db",
    "check:db": "npm run db:lint && npm run db:test",
    "test:app": "node --import ./scripts/register-server-only-stub.mjs --experimental-strip-types --test src/features/portfolio/server/__tests__/portfolio-media.test.ts src/features/portfolio/server/__tests__/portfolio-rpc-rest.test.ts src/features/portfolio/public/__tests__/public-portfolio.test.ts src/features/lead-intake/__tests__/phase-4a-lead-intake.test.ts src/features/lead-intake/__tests__/phase-4b2-lead-activation-readiness.test.ts src/features/crm/__tests__/phase-5b-crm-foundation.test.ts src/features/crm/__tests__/phase-5c1-crm-workspace.test.ts src/features/crm/__tests__/phase-5c2a-assignment-mutations.test.ts src/features/crm/__tests__/phase-5c2b-manual-lead.test.ts src/features/crm/__tests__/phase-5c2c-lifecycle-collaboration.test.ts src/features/crm/__tests__/phase-5d-bulk-import.test.ts",
    "test:phase-5c2c": "node --import ./scripts/register-server-only-stub.mjs --experimental-strip-types --test src/features/crm/__tests__/phase-5c2c-lifecycle-collaboration.test.ts",
    "qa:phase-5c2c-owner": "node scripts/phase-5c2c-owner-qa.mjs",
    "qa:phase-5c2c-browser": "node scripts/phase-5c2c-browser-qa.mjs",
    "qa:phase-5d-owner": "node scripts/phase-5d-owner-qa.mjs",
    "qa:phase-5d-browser": "node scripts/phase-5d-browser-qa.mjs",
    "test:image": "node --experimental-strip-types --test src/features/portfolio/server/__tests__/portfolio-image-pipeline.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "csv-parse": "5.6.0",
    "exceljs": "4.4.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
